class Node:
    def __init__(self, count=0):
        self.count = count
        self.keys = set()
        self.prev = None
        self.next = None

class AllOne:
    def __init__(self):
        self.head = Node(float('-inf'))
        self.tail = Node(float('inf'))
        self.head.next = self.tail
        self.tail.prev = self.head
        self.key_node = {}

    def _insert_after(self, node, new_node):
        new_node.prev = node
        new_node.next = node.next
        node.next.prev = new_node
        node.next = new_node

    def _remove(self, node):
        node.prev.next = node.next
        node.next.prev = node.prev

    def inc(self, key: str) -> None:
        if key in self.key_node:
            node = self.key_node[key]
            new_count = node.count + 1
            if node.next.count == new_count:
                new_node = node.next
            else:
                new_node = Node(new_count)
                self._insert_after(node, new_node)
            new_node.keys.add(key)
            node.keys.remove(key)
            if not node.keys:
                self._remove(node)
            self.key_node[key] = new_node
        else:
            if self.head.next.count == 1:
                new_node = self.head.next
            else:
                new_node = Node(1)
                self._insert_after(self.head, new_node)
            new_node.keys.add(key)
            self.key_node[key] = new_node

    def dec(self, key: str) -> None:
        node = self.key_node[key]
        new_count = node.count - 1
        node.keys.remove(key)
        if new_count == 0:
            del self.key_node[key]
        else:
            if node.prev.count == new_count:
                new_node = node.prev
            else:
                new_node = Node(new_count)
                self._insert_after(node.prev, new_node)
            new_node.keys.add(key)
            self.key_node[key] = new_node
        if not node.keys:
            self._remove(node)

    def getMaxKey(self) -> str:
        if self.tail.prev is self.head:
            return ""
        return next(iter(self.tail.prev.keys))

    def getMinKey(self) -> str:
        if self.head.next is self.tail:
            return ""
        return next(iter(self.head.next.keys))
