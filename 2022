from typing import List


class Solution:
    def construct2DArray(
        self, original: List[int], m: int, n: int
    ) -> List[List[int]]:

        # Check if we have enough elements
        if len(original) != m * n:
            return []

        result = []

        for i in range(m):
            row = original[i * n : (i + 1) * n]
            result.append(row)

        return result
