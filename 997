class Solution:
    def findJudge(self, n: int, trust: List[List[int]]) -> int:
        count = [0] * (n + 1)

        for a, b in trust:
            count[a] -= 1
            count[b] += 1

        for person in range(1, n + 1):
            if count[person] == n - 1:
                return person

        return -1
